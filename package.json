{
	"name": "my-clinic",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:server": "tsx watch server/index.ts",
		"dev:all": "npm-run-all --parallel dev dev:server",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:server": "tsc -p server/tsconfig.json --noEmit",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx server/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:drop": "rm -rf server/db/migrations/* data/clinic.db*",
		"db:seed": "tsx server/db/seed/index.ts",
		"db:reset": "rm -f data/clinic.db* && npm run db:migrate && npm run db:seed"	
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.2.12",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.1",
		"@types/node-cron": "^3.0.11",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.19.2",
		"drizzle-kit": "^0.31.10",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/jwt": "^10.2.2",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/static": "^10.1.4",
		"@fastify/websocket": "^11.3.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@tanstack/svelte-query": "^6.2.1",
		"better-sqlite3": "^13.0.3",
		"clsx": "^2.1.1",
		"date-fns-jalali": "^4.4.0-0",
		"dayjs": "^1.11.23",
		"dexie": "^4.4.6",
		"dotenv": "^18.0.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.5",
		"fastify-plugin": "^6.0.0",
		"firebase-admin": "^14.4.0",
		"formsnap": "^2.0.1",
		"jose": "^6.2.12",
		"lucide-svelte": "^1.0.1",
		"nanoid": "^6.0.1",
		"node-cron": "^4.6.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"web-push": "^3.6.7",
		"zod": "^4.6.5"
	}
}
